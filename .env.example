ANTHROPIC_API_KEY=your-api-key-here

# Opsional: override nama model tanpa edit kode. Default kalau tidak di-set:
# ANTHROPIC_MODEL=claude-haiku-4-5, GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-3.5-flash

# Opsional: set LLM_PROVIDER=gemini untuk pakai Google Gemini API (free tier,
# tanpa kartu kredit, daftar di https://aistudio.google.com) sebagai
# pengganti sementara Anthropic. Default: anthropic.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here

# --- channels/email_poller.py ---
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password-here

# Opsional: interval polling dalam detik. Default: 300
# POLL_INTERVAL=300

# --- channels/telegram_bot.py ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Wajib: daftar chat_id yang diizinkan pakai bot, dipisah koma
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# --- output/sheets_writer.py ---
# Path ke file JSON service account Google (lihat Google Cloud Console > IAM > Service Accounts).
# Spreadsheet tujuan harus di-share (edit access) ke email service account tsb.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
SPREADSHEET_ID=your-spreadsheet-id-here

# Opsional: nama worksheet tujuan. Default: Invoices
# WORKSHEET_NAME=Invoices

# --- reminder.py ---
# Wajib: chat_id Telegram tujuan pengiriman reminder jatuh tempo
# (juga dipakai email_poller.py untuk notifikasi duplikat_beda_total)
REMINDER_CHAT_ID=123456789

# Opsional: kirim reminder untuk tagihan yang jatuh tempo dalam N hari ke depan
# (termasuk yang sudah lewat/overdue). Default: 3
# REMINDER_DAYS=3

# Opsional: jam pengiriman reminder harian (0-23, waktu lokal server). Default: 8
# REMINDER_HOUR=8

# --- logging_config.py ---
# Opsional: level log (DEBUG/INFO/WARNING/ERROR). Default: INFO.
# Log selalu ditulis ke logs/invoice-ocr.log (rotasi otomatis, max 5MB x 3 file)
# dan ke stdout.
# LOG_LEVEL=INFO
